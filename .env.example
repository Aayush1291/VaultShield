# VaultShield root environment template.
#
# Copy this file to `.env` and fill in real values locally:
#     cp .env.example .env
#
# `.env` is git-ignored and MUST NOT be committed — it holds real credentials.
# This template contains PLACEHOLDERS ONLY. Never put a real secret here.

# --- Datastore (required) ---------------------------------------------------
# MongoDB connection string. Use a replica set / Atlas cluster (the backend
# relies on MongoDB transactions). No default exists: the backend raises at
# import if this is unset.
#   Atlas example:  mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
#   Local example:  mongodb://localhost:27017/vaultshield
VAULTSHIELD_MONGODB_URL=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Database name inside the cluster (optional; defaults to `vaultshield`).
VAULTSHIELD_MONGODB_NAME=vaultshield

# --- Django (optional; dev defaults apply when unset) -----------------------
# Set a real, unique secret key for anything shared or deployed.
VAULTSHIELD_SECRET_KEY=replace-with-a-long-random-secret

# `1` for local development, `0` for anything shared/deployed.
VAULTSHIELD_DEBUG=1

# Comma-separated allowed hosts. Default: localhost,127.0.0.1,web
VAULTSHIELD_ALLOWED_HOSTS=localhost,127.0.0.1,web
