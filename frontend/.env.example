# Copy to `.env.local` and edit as needed. Both variables are optional.

# Where the dev server (and `vite preview`) forwards `/api` and `/media`.
# Read by vite.config.js in Node, so it is not exposed to the browser.
# Host machine:      http://localhost:8000
# Compose network:   http://web:8000
VITE_API_PROXY_TARGET=http://localhost:8000

# Absolute origin for API requests, bypassing the proxy. Leave unset to keep
# requests same-origin, which is the only mode that works without CORS
# middleware on the backend.
# VITE_API_BASE_URL=
